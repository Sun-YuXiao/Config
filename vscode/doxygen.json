{
  // ============================ Doxygen ============================
  // 1. 调整文件注释的生成顺序，只保留 file, brief, copyright 和 custom
  "doxdocgen.file.fileOrder": [
    "file",
    "brief",
    "copyright",
    "custom"
  ],

  // 2. 修改版权信息，加入 HUST（{year} 会自动替换为当前年份）
  "doxdocgen.file.copyrightTag": [
    "@copyright Copyright (c) {year} HUST"
  ],

  // 3. 使用自定义标签生成星号分割线和中间的空行
  // 插件会自动在每一行前面加上 " * " 前缀，所以这里直接填星号和空字符串即可
  "doxdocgen.file.customTag": [
    "******************************************************************************",
    "",
    "",
    "",
    "******************************************************************************"
  ]
}